// 1281 — Subtract the Product and Sum of Digits 
// 1281. Subtract the Product and Sum of Digits of an Integer
int subtractProductAndSum(int n) {
    int digit;
    int sum = 0;
    int product = 1;

    while (n > 0) {
        digit = n % 10;

        sum = sum + digit;
        product = product * digit;

        n = n / 10;
    }

    return product - sum;
}
