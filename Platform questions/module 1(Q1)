//Read from STDIN, Write to STDOUT
// https://www.hackerearth.com/practice/basic-programming/input-output/basics-of-input-output/practice-problems/algorithm/io-exercise/
#include <stdio.h>

int main(){
	int num;
	char string[100];
	scanf("%d", &num);
	scanf(" %99s",string);
	printf("%d \n", num*2);
	printf("%s",string);
	return 0;
}
