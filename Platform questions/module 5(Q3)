//Factorial! 
//https://www.hackerearth.com/practice/basic-programming/input-output/basics-of-input-output/practice-problems/algorithm/find-factorial/
#include <stdio.h>

int main() {
    int n;
    long long fact = 1;

    scanf("%d", &n);

    for (int i = 1; i <= n; i++) {
        fact = fact * i;
    }

    printf("%lld", fact);

    return 0;
}
